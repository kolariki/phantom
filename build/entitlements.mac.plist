<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT (required for Electron / Chromium) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required for V8 in Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow DYLD environment variables -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Disable library validation (allows loading frameworks not signed by us) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Disable executable page protection (sometimes needed for V8) -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>

    <!-- Microphone access (for system audio capture via ScreenCaptureKit) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Apple Events (for system shortcuts / inter-app stuff) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Allow network connections (Anthropic, OpenAI APIs) -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
